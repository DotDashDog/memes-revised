experiments/WP-02/nuts-smoke/
experiments/WP-02/nuts-smoke-2/
experiments/WP-02/smoke-test/

# WP-12 outputs are flat rather than in run subdirs, so ignore by type.
# The *.md reports are the written record and stay tracked (as WP-02/report.md is).
experiments/WP-12/*.png
experiments/WP-12/*.json

# WP-16: ingested parquet and any raw archive copies are large and regeneratable.
# submissions_per_month.png is deliberately NOT ignored — it is the gate artifact
# the WP-16 coverage-completeness finding rests on, and at ~125 KB it is cheap to keep.
experiments/WP-16/*.parquet
experiments/WP-16/parquet/
reddit_dl/
reddit_archive/

